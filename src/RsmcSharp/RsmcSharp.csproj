<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <PackageId>RsmcSharp</PackageId>
        <Version>0.1.0-beta</Version>
        <Authors>01eksa</Authors>
        <Description>Fast and simple Reversi stateless model. C# wrapper over rsmc v0.1.0 (see https://github.com/01eksa/rsmc).</Description>
        <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/01eksa/rsmcsharp</RepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>RsmcSharp</RootNamespace>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="runtimes/win-x64/native/rsmc.dll"
              Pack="true"
              PackagePath="runtimes/win-x64/native/"
              CopyToOutputDirectory="PreserveNewest" />

        <None Include="runtimes/linux-x64/native/librsmc.so"
              Pack="true"
              PackagePath="runtimes/linux-x64/native/"
              CopyToOutputDirectory="PreserveNewest" />
        
        <None Include="runtimes/win-arm64/native/rsmc.dll"
              Pack="true"
              PackagePath="runtimes/win-arm64/native/"
              CopyToOutputDirectory="PreserveNewest" />

        <None Include="runtimes/linux-arm64/native/librsmc.so"
              Pack="true"
              PackagePath="runtimes/linux-arm64/native/"
              CopyToOutputDirectory="PreserveNewest" />

        <None Include="runtimes/osx-arm64/native/librsmc.dylib"
              Pack="true"
              PackagePath="runtimes/osx-arm64/native/"
              CopyToOutputDirectory="PreserveNewest" />

        <None Include="runtimes/osx-x64/native/librsmc.dylib"
              Pack="true"
              PackagePath="runtimes/osx-x64/native/"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
